# Example environment variables for this API
# Copy this file to .env and replace placeholders with real values

# MongoDB connection URI (example):
# URI=mongodb+srv://username:password@cluster0.mongodb.net/database?retryWrites=true&w=majority
URI=

# Server configuration
PORT=3000
NODE_ENV=development

# App secrets
# IMPORTANT: Replace with a strong secret. Example generation (Linux/macOS/WSL/Powershell):
#   openssl rand -hex 32
# or use a random password generator. Keep this value private.
JWT_SECRET=change_this_to_a_strong_secret
